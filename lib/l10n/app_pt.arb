  "ex_pecho_1_b1": "Desenvolve massa e força no peito",
  "ex_pecho_1_b2": "Fortalece os tríceps e ombros anteriores",
  "ex_pecho_1_b3": "Exercício composto com alta transferência para a força funcional",
  "ex_pecho_2_b1": "Enfatiza a porção clavicular (superior) do peito",
  "ex_pecho_2_b2": "Maior amplitude de movimento que a barra",
  "ex_pecho_2_b3": "Permite trabalhar cada lado de forma independente",
