  "template_fullBody_name": "Corpo inteiro",
  "template_push_name": "Empurrar",
  "template_pull_name": "Puxar",
  "template_torso_name": "Parte superior",
  "template_push_subtitle": "Peito · Ombros · Tríceps",
  "template_pull_subtitle": "Costas · Bíceps",
  "template_torso_subtitle": "Peito · Costas · Ombros",
